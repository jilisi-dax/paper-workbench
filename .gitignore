!/阅读器/app.js
!/阅读器/floating-window.js
!/阅读器/notes.js
!/阅读器/pdf-view.js
!/阅读器/style.css
!/阅读器/vendor/
/阅读器/vendor/*
!/阅读器/vendor/pdf-engine.js
